<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linear_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="قراءة بطاقة الرقم القومي"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 صوّر البطاقة"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="#1A73E8"
                android:padding="12dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الاسم"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="16dp" />
            <EditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="الاسم بالكامل"
                android:gravity="right"
                android:inputType="textPersonName"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الرقم القومي"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="14 رقم"
                android:gravity="right"
                android:inputType="number"
                android:maxLength="14"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تاريخ الميلاد"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_birth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="yyyy/MM/dd"
                android:gravity="right"
                android:inputType="text"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="النوع"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ذكر / أنثى"
                android:gravity="right"
                android:inputType="text"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="المحافظة"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_gov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="محافظة الميلاد"
                android:gravity="right"
                android:inputType="text"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="العنوان"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="العنوان"
                android:gravity="right"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:background="#FFFFFF"
                android:padding="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
