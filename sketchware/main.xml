<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linear_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="قراءة البطاقة الشخصية"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 امسح البطاقة"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="#1A73E8"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الاسم"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="16dp" />
            <EditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="الاسم"
                android:gravity="right"
                android:inputType="textPersonName"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم الأب"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_father"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اسم الأب"
                android:gravity="right"
                android:inputType="textPersonName"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="النسبة"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="النسبة"
                android:gravity="right"
                android:inputType="textPersonName"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم الأم ونسبتها"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_mother"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اسم ونسبة الأم"
                android:gravity="right"
                android:inputType="textPersonName"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الرقم الوطني"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="11 رقم"
                android:gravity="right"
                android:inputType="number"
                android:maxLength="11"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تاريخ الولادة"
                android:textColor="#555555"
                android:gravity="right"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edit_birth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="dd/MM/yyyy"
                android:gravity="right"
                android:inputType="text"
                android:background="#FFFFFF"
                android:padding="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
